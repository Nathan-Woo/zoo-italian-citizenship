rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function ownsProfile(profileId) {
      return isSignedIn() &&
        (profileId == request.auth.uid + '_student' || profileId == request.auth.uid + '_master');
    }
    function isMaster() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid + '_master'));
    }

    // Allowlist gate. Checked AFTER Google sign-in (the app never reads
    // this while signed out), so a plain isSignedIn() read is enough —
    // this avoids the unauthenticated-read edge cases that can surface
    // as a generic "client is offline" error in the Firestore SDK.
    match /allowedEmails/{email} {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if isMaster();
    }

    // One Google account (uid) can own up to two profiles:
    // {uid}_student and {uid}_master — kept as fully separate "account
    // files" so the same person can switch roles to test the app.
    match /profiles/{profileId} {
      allow get: if ownsProfile(profileId) || isMaster();
      // isMaster() lists are used for: looking a student up by email to
      // add to a roster, and reading roster members' profile docs.
      allow list: if isMaster();
      allow create: if ownsProfile(profileId);
      // A master needs to update a managed student's totalPoints when
      // grading a quiz, and their own managedStudentIds when editing
      // their roster — so isMaster() gets general update rights here.
      allow update: if ownsProfile(profileId) || isMaster();
      allow delete: if false;

      match /pointsLog/{entryId} {
        allow read: if ownsProfile(profileId) || isMaster();
        allow create: if ownsProfile(profileId) || isMaster();
        allow update, delete: if false;
      }

      match /selfStudyLog/{dateKey} {
        allow read: if ownsProfile(profileId) || isMaster();
        allow write: if ownsProfile(profileId);
      }
    }

    // Content library — any signed-in profile can read (for practice/
    // quizzes), only a master can write.
    match /content/{contentId} {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }

    // Quizzes — any signed-in profile can read (students query by
    // assignedTo array-contains their own profileId); only a master
    // creates/edits/deletes.
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMaster();

      match /submissions/{studentProfileId} {
        allow read: if ownsProfile(studentProfileId) || isMaster();
        allow create: if ownsProfile(studentProfileId);
        // Students can't edit after submitting; only a master grades.
        allow update: if isMaster();
        allow delete: if false;
      }
    }

    // Rewards — students read, masters manage.
    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }

    // App-wide settings (self-study point rules).
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }
  }
}
