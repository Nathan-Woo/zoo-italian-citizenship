rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Master-recorded vocab/quiz-prompt audio: any signed-in user can
    // listen (students need to hear it), only signed-in users can upload
    // (the app only exposes recording UI to masters, but we keep the rule
    // simple since role-checking against Firestore from Storage rules
    // requires a get() call — shown below for the stricter version).
    match /audio/content/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /audio/quiz-prompts/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Student quiz-response recordings: the student can upload their own,
    // and anyone signed in can read (master needs to grade; keeping read
    // open to isSignedIn keeps this simple for a 2-person app).
    match /quizzes/{quizId}/submissions/{studentUid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == studentUid;
    }
  }
}
