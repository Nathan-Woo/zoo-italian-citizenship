rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Master-recorded vocab/quiz-prompt audio: any signed-in profile can
    // listen, any signed-in profile can upload (the app only shows the
    // recording UI to masters, but keeping the rule simple here).
    match /audio/content/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /audio/quiz-prompts/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Student quiz-response recordings, stored under the student's
    // profileId (e.g. "abc123_student"), not their raw uid.
    match /quizzes/{quizId}/submissions/{studentProfileId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        studentProfileId == (request.auth.uid + '_student');
    }
  }
}
